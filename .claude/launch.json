{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@aihot/web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env", "apps/api/src/main.ts"],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env", "apps/web/server.ts"],
      "port": 3000
    },
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8790", "--directory", "static-site/dist"],
      "port": 8790
    }
  ]
}
